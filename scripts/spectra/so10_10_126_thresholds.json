    {"name": "Q_L",     "rep": [3, 2, 1, "1/3"],  "type": "weyl",    "copies": 3},
    {"name": "Q_R^c",   "rep": [3, 1, 2, "-1/3"], "type": "weyl",    "copies": 3},
    {"name": "L_L",     "rep": [1, 2, 1, "-1"],   "type": "weyl",    "copies": 3},
    {"name": "L_R^c",   "rep": [1, 1, 2, "1"],    "type": "weyl",    "copies": 3},
    {"name": "Phi",     "rep": [1, 2, 2, "0"],    "type": "complex", "copies": 1},
    {"name": "Delta_R", "rep": [1, 1, 3, "2"],    "type": "complex", "copies": 1}
  ],
  "gut_thresholds": [
    {"name": "10_H: T",          "rep": [3, 1, 1, "-2/3"], "type": "complex", "copies": 1, "mass_GeV": 1e16},
    {"name": "10_H: Tbar",       "rep": [3, 1, 1, "2/3"],  "type": "complex", "copies": 1, "mass_GeV": 1e16},
    {"name": "126_H: (3,1,1)",   "rep": [3, 1, 1, "-2/3"], "type": "complex", "copies": 1, "mass_GeV": 1e16},
    {"name": "126_H: (3b,1,1)",  "rep": [3, 1, 1, "2/3"],  "type": "complex", "copies": 1, "mass_GeV": 1e16},
    {"name": "126_H: (6,1,3)",   "rep": [6, 1, 3, "2/3"],  "type": "complex", "copies": 1, "mass_GeV": 1e16},
    {"name": "126_H: (3,1,3)",   "rep": [3, 1, 3, "-2/3"], "type": "complex", "copies": 1, "mass_GeV": 1e16},
    {"name": "126_H: (6b,3,1)",  "rep": [6, 3, 1, "-2/3"], "type": "complex", "copies": 1, "mass_GeV": 1e16},
    {"name": "126_H: (3b,3,1)",  "rep": [3, 3, 1, "2/3"],  "type": "complex", "copies": 1, "mass_GeV": 1e16},
